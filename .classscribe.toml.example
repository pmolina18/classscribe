# ClassScribe configuration (copy to .classscribe.toml and edit).
# All fields are optional; defaults are shown.

# Base folder where recordings, transcripts and summaries are stored.
workspace = "~/ClassScribe"

# Whisper language code. Leave empty "" for auto-detect. e.g. "es", "en".
language = ""

# Optional: override the whisper.cpp model path (defaults to <workspace>/models).
# model_path = "~/ClassScribe/models/ggml-large-v3-turbo.bin"

[transcription]
# Which backend transcribes audio:
#   "groq"  -> cloud (default; works without a local GPU or model download)
#   "local" -> whisper.cpp, fully offline and private (run `classscribe setup`)
provider = "groq"
# Groq (cloud) speech-to-text model.
groq_model = "whisper-large-v3-turbo"

[llm]
# Any OpenAI-compatible chat endpoint.
# Groq Cloud (free tier) — default:
base_url = "https://api.groq.com/openai/v1"
model = "llama-3.3-70b-versatile"
api_key_env = "GROQ_API_KEY"

# Fully local & private alternative (Ollama) — no API key needed:
# base_url = "http://localhost:11434/v1"
# model = "llama3.1"
# api_key_env = "OLLAMA_API_KEY"

[diagrams]
# Mermaid diagram type: mindmap | timeline | flowchart | auto (default).
# "auto" lets the model pick the best fit for the transcript content.
type = "auto"
