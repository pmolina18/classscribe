# Models (large binaries — downloaded via `classscribe setup`)
*.bin
models/

# User data (default workspace is ~/ClassScribe, outside the repo).
# NOTE: do NOT add a `ClassScribe/` rule — on case-insensitive macOS it would
# also ignore the `classscribe/` source package.
recordings/
transcripts/
summaries/
*.wav
*.mp3
*.m4a
*.mp4
*.mkv
*.srt
*.vtt

# Local config & secrets
.classscribe.toml
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Never publish KiroCrew / Kiro agent data
.kiro/
**/.kiro/
.kirocrew/
**/.kirocrew/
